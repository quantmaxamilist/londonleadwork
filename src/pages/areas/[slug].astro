---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import Reviews from '../../components/Reviews.astro';
import Faq from '../../components/Faq.astro';
import EnquiryBand from '../../components/EnquiryBand.astro';
import Icon from '../../components/Icon.astro';
import { areas, isLondon, nearby, fromBase, lead, contact, services, img, SITE, type Area } from '../../data/site';
export function getStaticPaths() { return areas.map((a, i) => ({ params: { slug: a.slug }, props: { a, i } })); }
const { a, i } = Astro.props as { a: Area; i: number };
const d = fromBase(a);
const near = nearby(a);
const heroImgs = ['curved-pediment-finished', 'parapet-gutter-stone-house', 'lead-dormer-cheeks', 'lead-lantern-ball-finial', 'lead-bay-roof-clay-tiles', 'cornice-capping-stone', 'curved-pediment-detail', 'lead-pier-cap-rolls'];
const hero = heroImgs[i % heroImgs.length];
const isBase = a.slug === 'bracknell';
const where = isBase ? 'right here in Bracknell, where we are based' : `about ${d} miles from our base in Bracknell`;
const faqs = [
  { q: `Do you do lead work in ${a.name}?`, a: `Yes. ${a.name} is ${where}, inside the ${a.county === 'Hampshire' ? 'home counties and M4 corridor' : a.county} area we cover.` },
  { q: `What lead work do you do in ${a.name}?`, a: `${lead.list.slice(0, 6).join(', ')}, and ${lead.list[6].charAt(0).toLowerCase() + lead.list[6].slice(1)}` },
  { q: 'What standard do you work to?', a: lead.standard },
  { q: `How do I get a quote in ${a.name}?`, a: `${lead.quote} — call ${contact.phone}, or use the form on our contact page.` },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: `Lead work in ${a.name}`, serviceType: 'Lead roofing', provider: { '@id': SITE + '/#business' }, areaServed: { '@type': 'City', name: a.name, geo: { '@type': 'GeoCoordinates', latitude: a.lat, longitude: a.lng } } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE + '/' }, { '@type': 'ListItem', position: 2, name: 'Areas', item: SITE + '/areas' }, { '@type': 'ListItem', position: 3, name: a.name, item: `${SITE}/areas/${a.slug}` }] },
];
---
<Base title={`Lead Work ${a.name} | Lead Roofing Specialists | London Leadwork`} description={`Lead roofing and lead work in ${a.name}, ${a.county}: lead sheet roofs, dormer cheeks, box gutters, bay roofs, chimney gutters and flashings. ${isBase ? 'Based in Bracknell.' : `${d} miles from our Bracknell base.`} Free quotes — ${contact.phone}.`} image={img(hero)} schema={schema}>
  <PageHero kicker={`${a.county} · ${isBase ? 'Our base' : `${d} miles from Bracknell`}`} title={`Lead work in ${a.name}`} lede={`${lead.p1} Lead work in ${a.name} and across ${a.county}.`} img={img(hero)} alt="Lead work by London Leadwork" crumbs={[{ label: 'Areas', href: '/areas' }, { label: a.name }]}>
    <div class="ap__btns"><a href={`/contact?area=${a.slug}`} class="btn">Free quote in {a.name} <Icon name="arrow" /></a><a href={contact.phoneHref} class="btn btn--ghost"><Icon name="phone" />{contact.phone}</a></div>
  </PageHero>
  <section class="sec stone">
    <div class="wrap ap__grid">
      <div class="ap__txt">
        <h2 class="display fs-d3" data-reveal>Lead roofing in {a.name}</h2>
        <p class="lede" data-reveal>{lead.p2}</p>
        <p data-reveal>We are based in Bracknell{isBase ? '' : `, about ${d} miles from ${a.name} as the crow flies`}, and cover {isLondon(a.county) ? 'every part of London' : a.county === 'Hampshire' ? 'the home counties and M4 corridor' : a.county} as well as {['London', 'Berkshire', 'Surrey', 'the Thames Valley'].filter((r) => !(r === 'London' && isLondon(a.county)) && r !== a.county).join(', ')}.</p>
        <p class="ap__std" data-reveal><Icon name="check" size={20} /><span>{lead.standard}</span></p>
      </div>
      <div data-reveal>
        <p class="label bz">Lead work in {a.name}</p>
        <ul role="list" class="ap__list">{services.map((s) => <li><a href={`/lead-work/${s.slug}`}><Icon name="check" size={18} />{s.name}</a></li>)}</ul>
        <p class="label bz ap__nl">Nearby</p>
        <ul role="list" class="ap__near">{near.map((n) => <li><a href={`/areas/${n.slug}`}>Lead work {n.name}</a></li>)}</ul>
      </div>
    </div>
  </section>
  <section class="sec paper"><div class="wrap"><h2 class="display fs-d3" data-reveal style="margin-bottom:32px">Our lead work</h2><ServiceGrid /></div></section>
  <Reviews />
  <Faq items={faqs} title={`Lead work in ${a.name}`} />
  <EnquiryBand title={`Lead work in ${a.name}? ${lead.quote}`} />
</Base>
<style>
  .ap__btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .ap__grid { display: grid; gap: 40px; }
  @media (min-width: 1000px) { .ap__grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 72px; } }
  .ap__txt { display: grid; gap: 20px; max-width: 62ch; }
  .ap__std { display: flex; gap: 12px; align-items: center; font-weight: 600; padding-top: 18px; border-top: 1px solid var(--line-light); }
  .ap__std svg, .ap__list svg { color: var(--bronze-deep); flex: none; }
  .ap__list, .ap__near { margin: 14px 0 0; border-top: 1px solid var(--line-light); }
  .ap__list a, .ap__near a { display: flex; gap: 12px; align-items: center; padding: 11px 0; border-bottom: 1px solid var(--line-light); text-decoration: none; }
  .ap__list a:hover, .ap__near a:hover { color: var(--bronze-deep); }
  .ap__nl { margin-top: 32px; }
</style>
