---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Reviews from '../components/Reviews.astro';
import EnquiryBand from '../components/EnquiryBand.astro';
import { google, brand, img } from '../data/site';
---
<Base title={`Reviews | ${google.rating}★ on Google | London Leadwork`} description={`${google.rating} out of 5 from ${google.count} Google reviews of ${brand.parent}, the Bracknell roofing company London Leadwork comes from. Read them word for word.`}>
  <PageHero kicker="Reviews" title={`${google.rating} on Google`} lede={`From ${google.count} reviews of ${brand.parent}.`} img={img('lead-dormer-cheeks')} alt="Lead dormer cheeks" crumbs={[{ label: 'Reviews' }]} />
  <Reviews heading={false} />
  <EnquiryBand />
</Base>
