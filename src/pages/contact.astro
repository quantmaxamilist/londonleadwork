---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { contact, services, areas, lead } from '../data/site';
const key = import.meta.env.PUBLIC_WEB3FORMS_KEY || '';
---
<Base title="Contact | Free Lead Work Quote | London Leadwork" description={`${lead.quote}. Call ${contact.phone} or send an enquiry online. Lead work across Berkshire, Thames Valley, Surrey and South London.`}>
  <section class="ct dark">
    <div class="wrap ct__grid">
      <div class="ct__info">
        <nav aria-label="Breadcrumb" class="crumbs label"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Contact</span></nav>
        <h1 class="display fs-hero metal">Free quote</h1>
        <p class="lede">{lead.quote}.</p>
        <ul role="list" class="ct__list">
          <li><a href={contact.phoneHref}><Icon name="phone" size={22} /><span class="label muted">Mobile</span><strong>{contact.phone}</strong></a></li>
          {contact.email && <li><a href={`mailto:${contact.email}`}><Icon name="mail" size={22} /><span class="label muted">Email</span><strong class="brk">{contact.email}</strong></a></li>}
          <li><span class="ct__row"><Icon name="pin" size={22} /><span class="label muted">Address</span><strong>{contact.street}, {contact.town} {contact.postcode}</strong></span></li>
        </ul>
      </div>

      <form class="cf" data-cf data-key={key} data-email={contact.email} data-phone={contact.phone} novalidate>
        <h2 class="label bz">Send an enquiry</h2>
        <fieldset class="cf__ticks">
          <legend class="label">What do you need?</legend>
          <div class="cf__tickgrid">
            {services.map((s) => <label class="tick"><input type="checkbox" name="service" value={s.name} data-k={s.slug} /><span>{s.name}</span></label>)}
            <label class="tick"><input type="checkbox" name="service" value="Repair / leak" data-k="repair" /><span>Repair / leak</span></label>
            <label class="tick"><input type="checkbox" name="service" value="Not sure" data-k="not-sure" /><span>Not sure</span></label>
          </div>
        </fieldset>
        <div class="cf__row">
          <label class="cf__f"><span class="label">Name *</span><input name="name" required autocomplete="name" /></label>
          <label class="cf__f"><span class="label">Phone *</span><input name="phone" type="tel" required autocomplete="tel" /></label>
        </div>
        <div class="cf__row">
          <label class="cf__f"><span class="label">Email *</span><input name="email" type="email" required autocomplete="email" /></label>
          <label class="cf__f"><span class="label">Town / area</span>
            <input name="area" list="areas" autocomplete="address-level2" data-area />
            <datalist id="areas">{areas.map((a) => <option value={a.name} data-slug={a.slug} />)}</datalist>
          </label>
        </div>
        <label class="cf__f"><span class="label">Tell us about the job *</span><textarea name="message" rows="5" required></textarea></label>
        <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />
        <button class="btn" type="submit">Send enquiry <Icon name="arrow" /></button>
        <p class="cf__status label" role="status" data-status></p>
      </form>
    </div>
  </section>
</Base>
<style>
  .ct { padding: calc(var(--hdr) + clamp(36px, 5vw, 72px)) 0 clamp(64px, 8vw, 120px); background: radial-gradient(50% 60% at 15% 20%, rgba(168, 139, 114, 0.18), transparent 70%), var(--black); min-height: 100svh; }
  .ct__grid { display: grid; gap: 48px; }
  @media (min-width: 1000px) { .ct__grid { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 72px; align-items: start; } }
  .ct__info { display: grid; gap: 24px; align-content: start; }
  .crumbs { display: flex; gap: 8px; color: var(--muted-on-dark); }
  .crumbs a { text-decoration: none; }
  .ct__list { margin: 0; border-top: 1px solid var(--line-dark); }
  .ct__list a, .ct__row { display: grid; grid-template-columns: 24px 90px minmax(0, 1fr); gap: 14px; align-items: center; padding: 18px 0; border-bottom: 1px solid var(--line-dark); text-decoration: none; }
  .ct__list strong { font: 600 clamp(1rem, 0.95rem + 0.4vw, 1.2rem)/1.3 var(--f-text); }
  .ct__list a:hover strong { color: var(--champagne); }
  .ct__small a { color: var(--champagne); }
  .brk { overflow-wrap: anywhere; }
  @media (max-width: 480px) { .ct__list a, .ct__row { grid-template-columns: 24px minmax(0, 1fr); } .ct__list .label { display: none; } }
  .cf { display: grid; gap: 18px; padding: clamp(20px, 3vw, 36px); background: var(--ink); border: 1px solid var(--line-dark); min-width: 0; }
  .cf__ticks { border: 0; padding: 0; margin: 0; display: grid; gap: 10px; min-width: 0; }
  .cf__tickgrid { display: flex; flex-wrap: wrap; gap: 8px; }
  .tick { position: relative; max-width: 100%; }
  .tick input { position: absolute; opacity: 0; pointer-events: none; }
  .tick span { display: inline-block; padding: 10px 14px; border: 1px solid var(--line-dark); cursor: pointer; font-size: 0.9rem; }
  .tick input:checked + span { border-color: var(--bronze); background: rgba(168, 139, 114, 0.2); color: var(--champagne); }
  .tick input:focus-visible + span { outline: 2px solid var(--bronze-hot); outline-offset: 2px; }
  .cf__row { display: grid; gap: 18px; }
  @media (min-width: 640px) { .cf__row { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .cf__f { display: grid; gap: 8px; min-width: 0; }
  .cf__f input, .cf__f textarea { font: inherit; color: inherit; background: var(--black); border: 1px solid var(--line-dark); padding: 12px 14px; border-radius: var(--radius); width: 100%; }
  .cf__f :is(input, textarea):focus { outline: none; border-color: var(--bronze); }
  .cf .btn { justify-self: start; }
  .cf__status:empty { display: none; }
</style>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-cf]');
  if (form) {
    const qs = new URLSearchParams(location.search);
    const pk = qs.get('package');
    if (pk) form.querySelectorAll<HTMLInputElement>('input[name="service"]').forEach((i) => { if (i.dataset.k === pk) i.checked = true; });
    const ar = qs.get('area');
    if (ar) { const opt = Array.from(document.querySelectorAll<HTMLOptionElement>('#areas option')).find((o) => o.dataset.slug === ar); const inp = form.querySelector<HTMLInputElement>('[data-area]'); if (opt && inp) inp.value = opt.value; }
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      const fd = new FormData(form);
      const svc = fd.getAll('service').join(', ');
      const body = [`Name: ${fd.get('name')}`, `Phone: ${fd.get('phone')}`, `Email: ${fd.get('email')}`, `Area: ${fd.get('area') || '-'}`, `Services: ${svc || '-'}`, '', String(fd.get('message'))].join('\n');
      const key = form.dataset.key;
      if (!key) {
        if (form.dataset.email) { location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Lead work enquiry')}&body=${encodeURIComponent(body)}`; }
        else { status.textContent = 'Please call us on ' + form.dataset.phone + ' — online enquiries are being set up.'; }
        return;
      }
      status.textContent = 'Sending…';
      try {
        const r = await fetch('https://api.web3forms.com/submit', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ access_key: key, subject: 'Lead work enquiry — London Leadwork website', from_name: 'London Leadwork website', botcheck: fd.get('botcheck') ? true : '', name: fd.get('name'), phone: fd.get('phone'), email: fd.get('email'), area: fd.get('area'), services: svc, message: fd.get('message') }) });
        const j = await r.json();
        status.textContent = j.success ? 'Thanks — your enquiry has been sent. We’ll be in touch.' : 'Sorry, that didn’t send. Please call or email us.';
        if (j.success) form.reset();
      } catch { status.textContent = 'Sorry, that didn’t send. Please call or email us.'; }
    });
  }
</script>
