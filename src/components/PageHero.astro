---
interface Props { kicker: string; title: string; lede?: string; img?: string; alt?: string; crumbs?: { label: string; href?: string }[] }
const { kicker, title, lede, img, alt = '', crumbs = [] } = Astro.props;
---
<section class="ph-hero dark">
  {img && <div class="ph-hero__bg ph no-shade"><img src={img} alt={alt} width="1600" height="1200" fetchpriority="high" /></div>}
  <div class="wrap ph-hero__in">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="crumbs label">
        <a href="/">Home</a>
        {crumbs.map((c) => (<><span aria-hidden="true">/</span>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</>))}
      </nav>
    )}
    <p class="label kicker bz">{kicker}</p>
    <h1 class="display fs-hero metal">{title}</h1>
    {lede && <p class="lede ph-hero__lede">{lede}</p>}
    <slot />
  </div>
</section>
<style>
  .ph-hero { position: relative; padding: calc(var(--hdr) + clamp(48px, 7vw, 110px)) 0 clamp(56px, 7vw, 100px); overflow: hidden; }
  .ph-hero__bg { position: absolute; inset: 0; }
  .ph-hero__bg img { opacity: 0.32; }
  .ph-hero__bg::after { content: ''; display: block; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(12, 11, 9, 0.96) 0%, rgba(12, 11, 9, 0.7) 60%, rgba(12, 11, 9, 0.45)); }
  .ph-hero__in { position: relative; display: grid; gap: 22px; justify-items: start; }
  .ph-hero h1 { max-width: 18ch; }
  .ph-hero__lede { max-width: 58ch; color: var(--text-on-dark); }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; color: var(--muted-on-dark); }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { color: var(--champagne); }
</style>
