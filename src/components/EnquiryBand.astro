---
import Icon from './Icon.astro';
import { contact, lead } from '../data/site';
interface Props { title?: string; pkg?: string }
const { title = lead.quote, pkg } = Astro.props;
---
<section class="eb bronzeband">
  <div class="wrap eb__in">
    <h2 class="display fs-d3">{title}</h2>
    <div class="eb__btns">
      <a href={pkg ? `/contact?package=${pkg}` : '/contact'} class="btn btn--dark">Get a free quote <Icon name="arrow" /></a>
      <a href={contact.phoneHref} class="btn btn--line"><Icon name="phone" />{contact.phone}</a>
    </div>
  </div>
</section>
<style>
  .eb { padding: clamp(48px, 6vw, 88px) 0; }
  .eb__in { display: grid; gap: 28px; align-items: center; }
  .eb h2 { max-width: 22ch; }
  .eb__btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn--dark { --bg: var(--black); --fg: var(--champagne); --bd: var(--black); }
  .btn--dark::before { background: var(--char-2); }
  .btn--line { --bg: transparent; --fg: var(--black); --bd: rgba(12, 11, 9, 0.5); }
  .btn--line::before { background: var(--black); }
  .btn--line:hover { color: var(--champagne); }
  @media (min-width: 1000px) { .eb__in { grid-template-columns: minmax(0, 1fr) auto; } }
</style>
