---
import Icon from './Icon.astro';
import { contact, services, areas, brand, google, regions } from '../data/site';
---
<footer class="ftr">
  <div class="wrap">
    <div class="ftr__top">
      <div class="ftr__brand">
        <img src="/img/brand/logo-640.png" alt="London Leadwork & Co Ltd" width="640" height="595" loading="lazy" />
        {google.url && (
          <a class="ftr__g" href={google.url} target="_blank" rel="noopener">
            <span class="ftr__stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={14} />)}</span>
            <span><strong>{google.rating}</strong> from {google.count} Google reviews</span>
          </a>
        )}
      </div>
      <div class="ftr__cols">
        <div>
          <p class="label muted">Lead work</p>
          <ul role="list">{services.map((s) => <li><a href={`/lead-work/${s.slug}`}>{s.name}</a></li>)}</ul>
        </div>
        <div>
          <p class="label muted">Areas</p>
          <ul role="list" class="ftr__areas">{areas.filter((a) => ['london','westminster','kensington','chelsea','islington','hampstead','hackney','greenwich','fulham','ealing','richmond','wimbledon','bracknell','reading','windsor','guildford'].includes(a.slug)).map((a) => <li><a href={`/areas/${a.slug}`}>{a.name}</a></li>)}<li><a href="/areas">All areas</a></li></ul>
        </div>
        <div>
          <p class="label muted">Contact</p>
          <ul role="list" class="ftr__contact">
            <li><a href={contact.phoneHref}><Icon name="phone" size={16} />{contact.phone}</a></li>
            {contact.email && <li><a href={`mailto:${contact.email}`}><Icon name="mail" size={16} /><span class="brk">{contact.email}</span></a></li>}
            <li><span class="ftr__addr"><Icon name="pin" size={16} /><span>{contact.street}, {contact.town} {contact.postcode}</span></span></li>
            <li><a href="/contact">Free quote</a></li>
            <li><a href="/our-work">Our work</a></li>
            <li><a href="/privacy-policy">Privacy</a></li>
          </ul>
        </div>
      </div>
    </div>
    <p class="ftr__cover muted">Lead work across London, Berkshire, Surrey and the Thames Valley. Based in Bracknell.</p>
    <div class="ftr__bottom">
      <p>© 2026 {brand.legalName}</p>
      <a href="/contact" class="link-arrow">Free quote <Icon name="arrow" size={16} /></a>
    </div>
  </div>
</footer>

<style>
  .ftr { background: var(--black); border-top: 1px solid var(--line-dark); padding: clamp(56px, 7vw, 96px) 0 calc(28px + env(safe-area-inset-bottom)); }
  .ftr__top { display: grid; gap: 48px; }
  .ftr__brand { display: grid; gap: 24px; align-content: start; }
  .ftr__brand img { width: 220px; height: auto; }
  .ftr__g { display: grid; gap: 6px; text-decoration: none; font-size: 0.9rem; color: var(--muted-on-dark); max-width: 260px; }
  .ftr__g strong { color: var(--champagne); }
  .ftr__stars { display: flex; gap: 2px; color: var(--bronze-hot); }
  .ftr__cols { display: grid; grid-template-columns: minmax(0, 1fr); gap: 36px 24px; }
  .ftr__cols ul { margin: 14px 0 0; display: grid; gap: 8px; }
  .ftr__areas { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 16px; }
  .ftr__cols a, .ftr__addr { color: var(--text-on-dark); text-decoration: none; font-size: 0.95rem; }
  .ftr__cols a:hover { color: var(--bronze-hot); }
  .ftr__contact a, .ftr__addr { display: inline-flex; align-items: center; gap: 10px; }
  .ftr__addr svg { flex: none; }
  .brk { overflow-wrap: anywhere; }
  .ftr__cover { margin-top: 48px; font-size: var(--fs-small); }
  .ftr__cover a { color: var(--champagne); }
  .ftr__bottom { margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--line-dark); display: flex; align-items: center; justify-content: space-between; gap: 16px; color: var(--muted-on-dark); font-size: var(--fs-small); }
  @media (min-width: 640px) { .ftr__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) {
    .ftr__top { grid-template-columns: 280px minmax(0, 1fr); }
    .ftr__cols { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 1fr); }
  }
  @media (max-width: 899px) { .ftr { padding-bottom: calc(96px + env(safe-area-inset-bottom)); } }
</style>
