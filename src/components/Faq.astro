---
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'Questions' } = Astro.props;
---
<section class="faq sec stone" aria-labelledby="faq-h">
  <div class="wrap faq__grid">
    <h2 id="faq-h" class="display fs-d2" data-reveal>{title}</h2>
    <div class="faq__list">
      {items.map((f) => (
        <details data-reveal>
          <summary>{f.q}<span aria-hidden="true" class="faq__plus"></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq__grid { display: grid; gap: 32px; }
  @media (min-width: 1000px) { .faq__grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 64px; } }
  .faq__list { border-top: 1px solid var(--line-light); }
  details { border-bottom: 1px solid var(--line-light); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 20px; padding: 20px 0; font: 600 1.08rem/1.35 var(--f-text); }
  summary::-webkit-details-marker { display: none; }
  .faq__plus { position: relative; flex: none; width: 16px; height: 16px; margin-top: 4px; }
  .faq__plus::before, .faq__plus::after { content: ''; position: absolute; left: 0; top: 7px; width: 16px; height: 2px; background: var(--bronze-deep); transition: transform 0.3s var(--ease); }
  .faq__plus::after { transform: rotate(90deg); }
  details[open] .faq__plus::after { transform: rotate(0); }
  details p { padding: 0 0 22px; max-width: 64ch; color: var(--muted-on-light); }
</style>
