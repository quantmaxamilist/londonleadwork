---
import Icon from './Icon.astro';
import { nav, contact, services } from '../data/site';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const active = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="hdr" data-hdr>
  <div class="hdr__in wrap">
    <a href="/" class="hdr__logo" aria-label="London Leadwork — home">
      <img src="/img/brand/lockup.png" alt="London Leadwork & Co Ltd" width="529" height="120" />
    </a>
    <nav class="hdr__nav" aria-label="Main">
      <ul role="list">
        {nav.slice(0, 4).map((n, i) => (
          <li class:list={{ 'has-menu': i === 0 }}>
            <a href={n.href} class:list={{ 'is-active': active(n.href) }}>{n.label}</a>
            {i === 0 && (
              <div class="menu">
                <ul role="list">{services.map((s) => <li><a href={`/lead-work/${s.slug}`}>{s.name}</a></li>)}</ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="hdr__cta">
      <a href={contact.phoneHref} class="hdr__phone label"><Icon name="phone" size={16} />{contact.phone}</a>
      <a href="/contact" class="btn btn--sm">Free quote</a>
      <button class="hdr__burger" aria-label="Open menu" aria-expanded="false" aria-controls="mnav" data-burger><Icon name="menu" size={24} /></button>
    </div>
  </div>
</header>

<div class="mnav" id="mnav" data-mnav hidden>
  <div class="mnav__top wrap">
    <a href="/" class="hdr__logo" aria-label="London Leadwork — home"><img src="/img/brand/lockup.png" alt="" width="529" height="120" /></a>
    <button class="hdr__burger" aria-label="Close menu" data-burger-close><Icon name="close" size={24} /></button>
  </div>
  <nav class="mnav__body wrap" aria-label="Mobile">
    <a class="mnav__big display" href="/lead-work">Lead work</a>
    <div class="mnav__sub">{services.map((s) => <a href={`/lead-work/${s.slug}`}>{s.name}</a>)}</div>
    {nav.slice(1).map((n) => <a class="mnav__big display" href={n.href}>{n.label}</a>)}
    <div class="mnav__contact">
      <a href={contact.phoneHref} class="btn"><Icon name="phone" />{contact.phone}</a>
      <a href={`mailto:${contact.email}`} class="btn btn--ghost"><Icon name="mail" />Email us</a>
    </div>
  </nav>
</div>

<style>
  .hdr { position: fixed; top: 0; left: 0; right: 0; z-index: var(--z-header); height: var(--hdr); background: rgba(12, 11, 9, 0.92); border-bottom: 1px solid var(--line-dark); transition: transform 0.35s var(--ease); }
  .hdr.is-hidden { transform: translate3d(0, -100%, 0); }
  .hdr__in { height: 100%; display: flex; align-items: center; gap: 24px; }
  .hdr__logo { flex: none; }
  .hdr__logo img { height: 44px; width: auto; }
  .hdr__nav { margin-left: auto; display: none; }
  .hdr__nav > ul { display: flex; gap: 4px; margin: 0; }
  .hdr__nav a { display: block; padding: 10px 12px; text-decoration: none; font: 600 0.76rem/1 var(--f-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-on-dark); transition: color 0.2s; }
  .hdr__nav a:hover, .hdr__nav a.is-active { color: var(--champagne); }
  .hdr__nav a.is-active { box-shadow: inset 0 -2px 0 var(--bronze); }
  .has-menu { position: relative; }
  .menu { position: absolute; top: 100%; left: 0; min-width: 340px; padding: 10px; background: var(--ink); border: 1px solid var(--line-dark); opacity: 0; visibility: hidden; transform: translate3d(0, 6px, 0); transition: opacity 0.2s, transform 0.2s var(--ease), visibility 0.2s; }
  .menu ul { margin: 0; }
  .menu a { text-transform: none; letter-spacing: 0; font: 500 0.95rem/1.3 var(--f-text); color: var(--text-on-dark); padding: 9px 12px; }
  .menu a:hover { background: var(--char); color: var(--champagne); }
  .has-menu:hover .menu, .has-menu:focus-within .menu { opacity: 1; visibility: visible; transform: none; }
  .hdr__cta { display: flex; align-items: center; gap: 14px; margin-left: auto; }
  .hdr__phone { display: none; align-items: center; gap: 8px; text-decoration: none; color: var(--champagne); white-space: nowrap; }
  .hdr__phone:hover { color: #fff; }
  .hdr__cta .btn { display: none; }
  .hdr__burger { display: inline-grid; place-items: center; width: 44px; height: 44px; background: none; border: 1px solid var(--line-dark); cursor: pointer; }
  @media (max-width: 380px) { .hdr__logo img { height: 36px; } }
  @media (min-width: 640px) { .hdr__cta .btn { display: inline-flex; } }
  @media (min-width: 1100px) {
    .hdr__nav { display: block; }
    .hdr__cta { margin-left: 8px; }
    .hdr__burger { display: none; }
  }
  @media (min-width: 1260px) { .hdr__phone { display: inline-flex; } }

  .mnav { position: fixed; inset: 0; z-index: var(--z-menu); background: var(--black); overflow-y: auto; }
  .mnav[hidden] { display: none; }
  .mnav__top { height: var(--hdr); display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line-dark); }
  .mnav__body { display: grid; gap: 6px; padding-top: 24px; padding-bottom: 40px; }
  .mnav__big { font-size: clamp(1.6rem, 7vw, 2.3rem); text-decoration: none; padding: 6px 0; color: var(--champagne); }
  .mnav__big:hover { color: #fff; }
  .mnav__sub { display: grid; gap: 2px; padding: 0 0 12px; }
  .mnav__sub a { color: var(--muted-on-dark); text-decoration: none; padding: 6px 0; }
  .mnav__contact { display: grid; gap: 10px; margin-top: 18px; }
</style>
